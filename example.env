# Copy to .env (root). Client value is baked in at build time.
VITE_DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID_HERE

# Worker secret. Also copy DISCORD_* values into worker/.dev.vars for local dev.
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET

# Bot token (optional). Set it in production to hard-enforce that rooms map to
# real activity instances (Activities -> Bot -> add bot to your app).
DISCORD_BOT_TOKEN=

# Opt-in casual browser rooms (open:<code> URLs). Leave unset in production to
# make code rooms nonexistent server-side even though clients support them.
OPEN_ROOMS=
